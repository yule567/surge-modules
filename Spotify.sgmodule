#!name=Spotify 原创实验版
#!desc=自编 JSON 显示广告过滤及随机播放提示调整；免费版顺序播放/音频广告不保证有效
#!category=去广告
# No third-party script dependencies. Passes protobuf/binary responses through unchanged.

[Script]
spotify-local = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/scripts/spotify-local.js

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
