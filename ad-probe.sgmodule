#!name=广告嗅探
#!desc=自动分析请求与响应，分类广告与追踪线索，不主动拦截、不上传数据
#!category=网络工具

[MITM]
hostname = %APPEND% *.jd.com, *.360buyimg.com, *.taobao.com, *.tmall.com, *.alicdn.com, *.pinduoduo.com, *.yangkeduo.com, *.pddpic.com, *.pdd.net, *.snssdk.com, *.pangle.io, gdt.qq.com, e.qq.com, ad.qq.com, *.doubleclick.net, *.googlesyndication.com

[Script]
Ad-Probe-Request = type=http-request,pattern=^https:\/\/(?:[^/]+\.)?(?:jd\.com|360buyimg\.com|taobao\.com|tmall\.com|alicdn\.com|pinduoduo\.com|yangkeduo\.com|pddpic\.com|pdd\.net|snssdk\.com|pangle\.io|gdt\.qq\.com|e\.qq\.com|ad\.qq\.com|doubleclick\.net|googlesyndication\.com)\/,requires-body=true,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js
Ad-Probe-Response = type=http-response,pattern=^https:\/\/(?:[^/]+\.)?(?:jd\.com|360buyimg\.com|taobao\.com|tmall\.com|alicdn\.com|pinduoduo\.com|yangkeduo\.com|pddpic\.com|pdd\.net|snssdk\.com|pangle\.io|gdt\.qq\.com|e\.qq\.com|ad\.qq\.com|doubleclick\.net|googlesyndication\.com)\/,requires-body=true,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js
Ad-Probe-Panel = type=generic,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js,timeout=5

[Panel]
Ad-Probe = title="通用 广告嗅探 V4",content="等待捕获",style=info,script-name=Ad-Probe-Panel,update-interval=1
