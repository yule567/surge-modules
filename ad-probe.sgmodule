#!name=智能广告嗅探
#!desc=V8.1 安全优先；仅指定域名及京东接口，非全局嗅探，不拦截、不上传，建议按需开启
#!category=网络工具

[MITM]
hostname = %APPEND% ads-img-x.jd.com, ads-video-x.jd.com, dsp-x.jd.com, bdsp-x.jd.com, im-x.jd.com, api.m.jd.com, ad.qq.com, gdt.qq.com, pagead2.googlesyndication.com, googleads.g.doubleclick.net

[Script]
Ad-Probe-Request = type=http-request,pattern=^https://(?:(?:ads-img-x\.jd\.com|ads-video-x\.jd\.com|dsp-x\.jd\.com|bdsp-x\.jd\.com|ad\.qq\.com|gdt\.qq\.com|pagead2\.googlesyndication\.com|googleads\.g\.doubleclick\.net)(?::443)?(?:/|$)|im-x\.jd\.com(?::443)?/dsp(?:[/?]|$)),requires-body=false,timeout=3,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js?v=8.1
Ad-Probe-Response = type=http-response,pattern=^https://api\.m\.jd\.com(?::443)?/(?:client\.action|api)(?:[/?]|$),requires-body=true,max-size=131072,timeout=3,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js?v=8.1
Ad-Probe-Panel = type=generic,script-path=https://raw.githubusercontent.com/yule567/surge-modules/main/ad-probe.js?v=8.1,timeout=3

[Panel]
Ad-Probe = title="智能广告嗅探 V8.1",content="等待捕获",style=info,script-name=Ad-Probe-Panel,update-interval=30
